  "mathematical_models": [
    {
      "id": "math.uptime",
      "expression": "U_s = integral_0^T indicator(status s active at t) dt / T",
      "meaning": "Status uptime is an observation or simulation output; possession of a source is not uptime=1.",
      "required_inputs": [
        "duration",
        "legal trigger rate",
        "refresh rule",
        "removal/conflicts"
      ],
      "status": "mathematical_definition"
    },
    {
      "id": "math.energy_balance",
      "expression": "E(t+dt) = clamp(E(t) + G(t,dt) - C(t,dt), 0, capacity(t)); temporary reserve uses its own expiry rules",
      "meaning": "Must distinguish current energy, capacity, and temporary energy. No infinite chain without nonnegative long-run balance and legal activation timing.",
      "required_inputs": [
        "cost per activation",
        "grant amounts",
        "expiry",
        "capacity",
        "reload"
      ],
      "status": "conservation_model_template_unparameterized"
    },
    {
      "id": "math.refill_marginal",
      "expression": "fuel_added_per_activation = max(0, capacity - fuel_before_activation)",
      "meaning": "A full-refill part has zero immediate fuel value at full tank. Benefit depends on actual consumption between activations.",
      "required_inputs": [
        "fuel capacity",
        "fuel state",
        "activation timing"
      ],
      "status": "derived_from_full_refill_claim"
    },
    {
      "id": "math.activation_bound",
      "expression": "N <= min(N_energy, N_reload, N_opportunities)",
      "meaning": "Fast reload alone does not give unlimited casts. N_reload must handle per-ability cooldown and first-use availability.",
      "required_inputs": [
        "energy ledger",
        "reload timers",
        "opportunity windows"
      ],
      "status": "resource_bound_not_game_coefficient"
    },
    {
      "id": "math.heat_balance",
      "expression": "dH/dt = heating(speed,boost,states) - cooling(speed,states)",
      "meaning": "No numerical sustainable-Ramjet conclusion without heating/cooling functions, heat cap and shutdown semantics.",
      "required_inputs": [
        "heating function",
        "cooling function",
        "heat cap",
        "restart rules"
      ],
      "status": "model_template_unparameterized"
    },
    {
      "id": "math.conditional_power",
      "expression": "P(t) = P_base(t) * (1 + b * indicator(prerequisite active)) for one isolated relative bonus, if source wording follows ordinary relative-percent semantics",
      "meaning": "Power modifier does not establish speed or lap-time modifier; stacking other bonuses requires separate evidence.",
      "required_inputs": [
        "base power",
        "active-state trajectory",
        "stacking semantics"
      ],
      "status": "conditional_interpretation"
    }
